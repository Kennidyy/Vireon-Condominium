{
  "name": "Vireon-Condominium",
  "private": true,
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "lint": "turbo run lint",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check-types": "turbo run check-types",
    "test": "turbo run test",
    "eval": "bun run format && bun run lint && bun run check-types && bun run format:check && bun run test",
    "infra:up": "docker compose --env-file src/apps/api/.env -f src/apps/api/infrastructure/docker/docker-compose.yaml up -d",
    "infra:down": "docker compose --env-file src/apps/api/.env -f src/apps/api/infrastructure/docker/docker-compose.yaml down",
    "infra:logs": "docker compose --env-file src/apps/api/.env -f src/apps/api/infrastructure/docker/docker-compose.yaml logs -f",
    "infra:restart": "docker compose --env-file src/apps/api/.env -f src/apps/api/infrastructure/docker/docker-compose.yaml restart",
    "db:up": "docker compose --env-file src/apps/api/.env -f src/apps/api/infrastructure/docker/docker-compose.yaml up -d database",
    "db:stop": "docker compose --env-file src/apps/api/.env -f src/apps/api/infrastructure/docker/docker-compose.yaml stop database",
    "db:logs": "docker compose --env-file src/apps/api/.env -f src/apps/api/infrastructure/docker/docker-compose.yaml logs -f database",
    "db:restart": "docker compose --env-file src/apps/api/.env -f src/apps/api/infrastructure/docker/docker-compose.yaml restart database"
  },
  "devDependencies": {
    "prettier": "^3.7.4",
    "turbo": "^2.10.5",
    "typescript": "5.9.2"
  },
  "engines": {
    "node": ">=18"
  },
  "devEngines": {
    "packageManager": {
      "name": "bun",
      "version": "1.3.14"
    }
  },
  "workspaces": [
    "src/apps/*",
    "packages/*"
  ],
  "dependencies": {
    "uuidv7": "^1.2.1"
  }
}
